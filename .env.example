# Copy to .env.local for development. Never commit the filled-in file.
#
# Two classes of variable here, and the difference matters when deploying:
#
#   NEXT_PUBLIC_*  are inlined into the client bundle by `next build`. They are
#                  BUILD-time inputs. Setting them in docker-compose has no
#                  effect on an already-built image — they must be passed as
#                  build args (see Dockerfile and .github/workflows).
#   everything else is read by route handlers at request time, so it belongs in
#                  the container's environment and never enters the image.

# ── Backend (server-side only) ──────────────────────────────────────────────
# The NestJS account API. lib/backend.ts is the single gateway to it; nothing
# in the browser ever calls it directly, which is what avoids CORS entirely and
# lets the API stay off the public internet if you want it to.
# In the server stack this is the compose service name, not a public URL.
BACKEND_API_URL=http://api:3000/v1

# Optional bearer forwarded on the user-count proxy.
BACKEND_SERVICE_TOKEN=

# ── Studio handoff (build-time) ─────────────────────────────────────────────
# Where a newly registered user is sent, carrying their tokens. This is the
# Modal deployment of the Studio. lib/session.ts already defaults to this exact
# value, so it only needs setting here to point somewhere else.
NEXT_PUBLIC_MAIN_APP_URL=https://isoqovjorabek2--th-labs-dubbing-web.modal.run

# ── Google sign-in ──────────────────────────────────────────────────────────
# Build-time: the button does not render without it.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Server-side HMAC key used to derive a stable per-Google-account password.
# Defaults to the literal "th-labs-google" if unset — set it to a real secret.
#   openssl rand -hex 32
GOOGLE_AUTH_SECRET=

# ── Email (server-side only) ────────────────────────────────────────────────
# Powers lib/email.ts. Note that sendWelcomeEmail() is currently imported by
# nothing, so leaving these unset changes no behaviour today.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
